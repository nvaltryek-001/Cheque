# Copy to backend/.env and adjust. Paths are relative to the project root.
CV_OCR_DATASET=dataset
CV_SIGNATURE_DATASET=signature
# CV_SECRET_KEY=change-me-to-a-long-random-string   (auto-generated in instance/secret_key if empty)
# CV_ADMIN_PASSWORD=choose-a-strong-password         (first run only; otherwise a random one is printed)
CV_OCR_ENGINE=auto            # auto | paddle | tesseract | none
# CV_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CV_MAX_UPLOAD_MB=10
CV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CV_TOKEN_MAX_AGE=28800
# --- security limits (defaults shown; the Render blueprint sets CV_MIN_PASSWORD_LENGTH=12) ---
# CV_MIN_PASSWORD_LENGTH=8        # also applied to CV_ADMIN_PASSWORD
# CV_LOGIN_MAX_ATTEMPTS=5         # failed sign-ins per client IP + username in the window below
# CV_LOGIN_IP_MAX_ATTEMPTS=20     # failed sign-ins per client IP across all usernames
# CV_LOGIN_LOCK_SECONDS=300       # length of that window
# CV_RATE_LIMIT_PER_MIN=120       # expensive calls (uploads, verifications) per user per minute, 0 = off
# CV_MAX_IMAGE_PIXELS=25000000    # decoded image size limit, checked from the header before decoding
# CV_PROXY_HOPS=0                 # reverse proxies in front of the app (Render: 1); 0 = trust no X-Forwarded-*
# CV_HSTS_MAX_AGE=31536000        # sent only on HTTPS responses, 0 = never
# --- sign-in by institutional email (docs/AUTHENTICATION.md); off until CV_EMAIL_DELIVERY is set ---
# CV_EMAIL_DOMAINS=saividya.ac.in       # exact domains that may sign in (comma separated); no list of people
# CV_EMAIL_DELIVERY=smtp                # smtp | log (development only: the code goes into the server log)
# CV_SMTP_HOST=smtp.example.org
# CV_SMTP_PORT=587
# CV_SMTP_SECURITY=starttls             # starttls | ssl | none (none only for a server on this machine)
# CV_SMTP_USER=no-reply@example.org
# CV_SMTP_FROM=no-reply@example.org
# CV_SMTP_PASSWORD=                     # set it in the environment of the running server, never in a committed file
# CV_EMAIL_DEFAULT_ROLE=pending         # pending (wait for approval) | auditor | operator; never admin
# CV_ADMIN_EMAILS=                      # addresses that become administrators after proving the mailbox
# CV_PASSWORD_LOGIN=1                   # 0 switches username + password sign-in off
# CV_EMAIL_CODE_TTL=600  CV_EMAIL_CODE_ATTEMPTS=5  CV_EMAIL_RESEND_SECONDS=30
# CV_EMAIL_REQUESTS_PER_ADDRESS=5  CV_EMAIL_REQUESTS_PER_IP=20  CV_EMAIL_REQUEST_WINDOW=900
